{
  "gitProvider": "github",
  "usernames": ["this-is-tobi"],
  "reposFilter": [
    ".github",
    "cheatsheets",
    "docpress",
    "docpress-action",
    "dotfiles",
    "github-workflows",
    "gitmojidex",
    "helm-charts",
    "multiarch-mirror",
    "ohmlab",
    "rta",
    "rta-plugins",
    "template-monorepo-ts",
    "tools",
    "!tuto-static",
    "!tuto-static-infra-manifest",
    "!dso-tuto-static",
    "!dso-tuto-static-deploy",
    "!flower-recognition"
  ],
  "branch": "main",
  "acronyms": [
    "AI",
    "CLI",
    "GPG",
    "JS",
    "MCP",
    "OIDC",
    "PR",
    "RTA",
    "SQL",
    "TS",
    "TUI",
    "YAML",
    "ArgoCD",
    "DevOps",
    "GitHub",
    "Go",
    "NodeJS",
    "OpenSSL",
    "SonarQube",
    "VSCode",
    "npm",
    "buildx",
    "gh",
    "kubectl",
    "mise",
    "pg_dump",
    "pg_restore"
  ],
  "hero": {
    "tagline": "Robots are everywhere",
    "image": { "src": "/avatar.jpg", "alt": "Tobi" },
    "actions": [
      { "theme": "brand", "text": "About me", "link": "/about" },
      { "theme": "alt", "text": "Professional projects", "link": "/projects" }
    ]
  },
  "extraHeaderPages": ["./extras/pages"],
  "extraPublicContent": ["./extras/public"],
  "extraTheme": ["./extras/theme"],
  "vitepressConfig": {
    "base": "/",
    "srcDir": "./docs",
    "cleanUrls": true,
    "vite": {
      "publicDir": "../public"
    },
    "title": "Tobi",
    "description": "Open source projects, documentation and contributions by Tobi.",
    "lang": "en-US",
    "ignoreDeadLinks": "localhostLinks",
    "head": [
      ["link", { "rel": "icon", "type": "image/png", "sizes": "32x32", "href": "/favicon-32x32.png" }],
      ["link", { "rel": "icon", "type": "image/png", "sizes": "16x16", "href": "/favicon-16x16.png" }],
      ["link", { "rel": "apple-touch-icon", "sizes": "180x180", "href": "/apple-touch-icon.png" }],
      ["link", { "rel": "manifest", "href": "/site.webmanifest" }],
      ["meta", { "name": "theme-color", "media": "(prefers-color-scheme: light)", "content": "#ffffff" }],
      ["meta", { "name": "theme-color", "media": "(prefers-color-scheme: dark)", "content": "#0a0a0a" }],
      ["meta", { "property": "og:type", "content": "website" }],
      ["meta", { "property": "og:site_name", "content": "Tobi" }],
      ["meta", { "property": "og:image", "content": "https://this-is-tobi.com/avatar.jpg" }],
      ["meta", { "name": "twitter:card", "content": "summary" }]
    ],
    "themeConfig": {
      "logo": { "src": "/logo.png", "alt": "" },
      "nav": [{ "text": "Home", "link": "/" }],
      "socialLinks": [
        { "icon": "github", "link": "https://github.com/this-is-tobi", "ariaLabel": "GitHub" },
        { "icon": "bluesky", "link": "https://bsky.app/profile/this-is-tobi.com", "ariaLabel": "Bluesky" }
      ],
      "outline": [2, 3],
      "footer": {
        "message": "Released under the MIT License.",
        "copyright": "Copyright © 2020-present Thibault Colin"
      }
    }
  },
  "forks": true
}
